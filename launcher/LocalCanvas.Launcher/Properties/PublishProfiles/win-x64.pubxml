<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained LocalCanvas.exe for 64-bit Windows: it needs no .NET
  installed on the machine that runs it.

    dotnet publish launcher\LocalCanvas.Launcher -p:PublishProfile=win-x64

  The exe belongs at the root of the LocalCanvas folder, beside scripts\.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
