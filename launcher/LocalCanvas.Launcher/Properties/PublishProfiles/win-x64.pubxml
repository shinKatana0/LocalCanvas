<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained LocalCanvas.exe for 64-bit Windows: it needs no .NET
  installed on the machine that runs it.

    dotnet publish launcher\LocalCanvas.Launcher -p:PublishProfile=win-x64

  The exe belongs at the root of the LocalCanvas folder, beside scripts\.

  IncludeNativeLibrariesForSelfExtract is deliberately not set: the runtime is
  linked into the single-file host and Windows Forms has no native libraries
  of its own, so the output is one file either way -- and without it nothing
  is ever unpacked into the user's temporary folder.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
