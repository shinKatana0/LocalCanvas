<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up, dark. See `values-v31/styles.xml` for why this file is
     a full copy rather than an override. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/lc_canvas</item>
        <item name="android:windowSplashScreenBackground">@color/lc_canvas</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lc_canvas</item>
        <item name="android:colorBackground">@color/lc_canvas</item>
    </style>
</resources>
